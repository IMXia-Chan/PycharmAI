# 复制为 server/.env 再填写
# 访问令牌(与 backend/.env 的 CLOUD_TOKEN 保持一致;也是后端↔云端之间的服务间密钥,建议改成随机长串)
CLOUD_TOKEN=dev-token
# 云端数据库文件
DB_PATH=cloud.db
# 云端服务端口
PORT=8001

# ---- 管理员登录(2FA)----
# 管理员用户名(第二用户名,别和普通用户名重复)
ADMIN_USERNAME=
# 管理员密码的 SHA-256 哈希(不存明文)。生成方式:
#   python -c "import hashlib; print(hashlib.sha256(input('密码:').encode()).hexdigest())"
ADMIN_PASSWORD_HASH=
# 接收验证码的邮箱
ADMIN_EMAIL=
# QQ 邮箱 SMTP(发验证码用):SMTP_PASSWORD 填「授权码」,不是 QQ 密码
# 获取:QQ 邮箱网页版 → 设置 → 账户 → 开启 SMTP 服务 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
