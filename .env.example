# ===== 后端 backend/ 使用的环境变量(复制到 backend/.env 再填写)=====

# DeepSeek API(必填,否则 AI 分析/搜索/对比会降级为内置兜底)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 真云端文件库(server/)。填了就走远程同步;留空则退回本地 SQLite 调试
CLOUD_URL=
CLOUD_TOKEN=dev-token

# 本地调试用
PORT=8000
LOCAL_DB_PATH=assistant.db
