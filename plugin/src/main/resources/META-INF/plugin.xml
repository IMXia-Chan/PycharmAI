<idea-plugin>
    <id>com.assistant.python-assistant</id>
    <name>Python 代码助手</name>
    <version>1.0.0</version>
    <vendor>assistant</vendor>

    <description><![CDATA[
        面向 Python 初学者的 AI 代码助手:
        <ul>
        <li>输入时检测常见错误/不规范写法,并在代码旁内联提示</li>
        <li>「网页端 AI 深度搜索」一个入口搞定:AI 问答、中文搜函数、学习笔记、函数对比、导出 PDF</li>
        <li>解释代码、报错解释、记录错误代码都存入本地文件库(按文件分组),勾选后一键上传网页生成笔记</li>
        </ul>
        首次使用会弹出「请接入你需要调用的 api」,填你自己的 DeepSeek API key(只存本机,绝不写进代码)。
        网页端也需要在右上角填你自己的 key(只存浏览器本机)。
        需要先启动本地的 Python 后端服务(见项目 README)。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.assistant.AssistantSettings"/>
        <editorFactoryListener implementation="com.assistant.EditorListener"/>
        <toolWindow id="代码片段" anchor="right" icon="/icons/snippet.svg"
                    factoryClass="com.assistant.SnippetToolWindowFactory"/>
        <toolWindow id="文件库" anchor="right"
                    factoryClass="com.assistant.LibraryToolWindowFactory"/>
        <postStartupActivity implementation="com.assistant.ApiKeyStartupActivity"/>
        <notificationGroup id="PythonAssistant.Notifications" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="Assistant.Configure" class="com.assistant.ConfigureAction"
                text="接入你的 API…"
                description="配置 DeepSeek API key 与云端身份">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>
        <action id="Assistant.DeepSearch" class="com.assistant.DeepSearchAction"
                text="网页端 AI 深度搜索"
                description="打开网页工作台:AI 问答 / 中文搜函数 / 学习笔记 / 函数对比 / 导出 PDF">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt A"/>
        </action>
        <action id="Assistant.RecordCode" class="com.assistant.RecordCodeAction"
                text="记录错误代码"
                description="把当前选中(或整个文件)代码记录到本地文件库">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Assistant.ExplainCode" class="com.assistant.ExplainCodeAction"
                text="解释代码…"
                description="用中文解释选中的代码在做什么">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt E"/>
        </action>
        <action id="Assistant.GenerateComment" class="com.assistant.GenerateCommentAction"
                text="生成注释"
                description="为选中的代码自动加上中文注释">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt G"/>
        </action>
        <action id="Assistant.AutoFix" class="com.assistant.AutoFixAction"
                text="自动修复代码"
                description="找出选中代码的错误并自动修复">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R"/>
        </action>
        <action id="Assistant.ExplainError" class="com.assistant.ExplainErrorAction"
                text="报错解释…"
                description="粘贴运行时报错,AI 解释原因与改法">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt X"/>
        </action>
        <action id="Assistant.SaveSnippet" class="com.assistant.SaveSnippetAction"
                text="保存代码片段…"
                description="把选中的代码保存到代码片段库">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt K"/>
        </action>
        <action id="Assistant.OpenSnippet" class="com.assistant.OpenSnippetAction"
                text="打开代码片段库"
                description="打开/激活右侧的代码片段窗口">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt W"/>
        </action>
        <action id="Assistant.AdminLogin" class="com.assistant.AdminLoginAction"
                text="管理员登录…"
                description="管理员登录(用户名+密码+邮箱验证码)">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
